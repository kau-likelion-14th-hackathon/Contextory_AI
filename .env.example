# 이 파일만 커밋합니다. 실제 값이 담긴 .env 는 커밋하지 않습니다.

# PostgreSQL (pgvector 포함). Spring Boot 백엔드와 같은 DB 를 공유합니다.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/contextory

# LLM / 임베딩
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Firebase (Firestore)
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# 벡터 스토어
VECTOR_TABLE_NAME=contextory_embeddings

LOG_LEVEL=INFO
