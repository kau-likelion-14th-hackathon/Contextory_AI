# Server Config
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (pgvector) DB Config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=contextory_db

# DB 커넥션 풀 크기 (선택, 미설정 시 기본값 사용)
# DB_POOL_SIZE: 상시 유지 커넥션 수 (기본 10)
# DB_MAX_OVERFLOW: 풀 소진 시 추가로 허용할 커넥션 수 (기본 20)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# OpenAI Config
OPENAI_API_KEY=your_openai_api_key_here

# Internal API (Backend <-> AI) Config
# Backend가 POST /internal/v1/analyses 요청 시 X-Internal-Api-Key 헤더로 보내는 값과 동일해야 하며,
# AI가 분석 완료/실패 콜백을 보낼 때도 동일 헤더로 사용한다.
INTERNAL_API_KEY=your_internal_api_key_here

# 비동기 분석 작업(ai_analysis_jobs) 관리 정책 (선택, 미설정 시 기본값 사용)
# JOB_TIMEOUT_MINUTES: PROCESSING 상태가 이 시간을 넘기면 좀비 작업으로 보고 FAILED 처리한다.
# JOB_RETENTION_DAYS: 종료(COMPLETED/FAILED)된 작업 행의 보존 기간. 0이면 자동 삭제하지 않는다.
JOB_TIMEOUT_MINUTES=30
JOB_RETENTION_DAYS=0

# Google API Config
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id_here