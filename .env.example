# Server Config
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (pgvector) DB Config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=contextory_db

# DB 커넥션 풀 크기 (선택, 미설정 시 기본값 사용)
# DB_POOL_SIZE: 상시 유지 커넥션 수 (기본 10)
# DB_MAX_OVERFLOW: 풀 소진 시 추가로 허용할 커넥션 수 (기본 20)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# OpenAI Config
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o
# 보조 모델 (Context Filter Agent / 검색 쿼리 번역)
CONTEXT_FILTER_MODEL=gpt-4o-mini
TRANSLATION_MODEL=gpt-4o-mini
# 검색 쿼리 번역은 재현 가능해야 한다. 쿼리가 실행마다 흔들리면 최고 유사도가
# SIM_THRESHOLD를 넘나들어 같은 PR의 "근거 부족" 판정이 뒤집힌다.
TRANSLATION_TEMPERATURE=0.0
TRANSLATION_SEED=42

# RAG Retrieval / Context Filter Config
RAG_TOP_K=5
SIM_THRESHOLD=0.5
# on | off | llm
#   on  : 유사도 임계값 기반 필터 (기본)
#   off : 검색 결과 전량 통과 (필터 기여도 A/B 측정용)
#   llm : LLM Context Filter Agent가 관련성 판단 (호출 실패 시 임계값 필터로 폴백)
FILTER_MODE=on
# LLM 필터에 넘길 chunk 본문 최대 길이
CONTEXT_FILTER_SNIPPET_CHARS=600
# threshold 이상 chunk가 이 개수 미만이면 "근거 부족" 경로로 처리
MIN_GROUNDING_EVIDENCE_COUNT=1

# Confidence Config (LLM 자기평가 금지 — 검색 신호 기반 가중 조합)
# 강한 근거 기준. 절대값이 아니라 관측 분포 기준이다(p90=0.6127 → 상위 10%).
# 임베딩 모델/코퍼스가 바뀌면 scripts/measure_grounding.py 로 다시 재고 조정할 것.
STRONG_EVIDENCE_THRESHOLD=0.62
CONFIDENCE_W_TOP_SCORE=0.5
CONFIDENCE_W_EVIDENCE_COUNT=0.2
CONFIDENCE_W_STRONG_EVIDENCE=0.2
CONFIDENCE_W_FILTER_RETENTION=0.1
CONFIDENCE_EVIDENCE_TARGET_COUNT=3
CONFIDENCE_CONFIRM_THRESHOLD=0.6
FILTER_RATIO_WARN_THRESHOLD=0.8

# Evaluation Config (eval/ 전용)
EVAL_DEFAULT_K=5

# Internal API (Backend <-> AI) Config
# Backend가 POST /internal/v1/analyses 요청 시 X-Internal-Api-Key 헤더로 보내는 값과 동일해야 하며,
# AI가 분석 완료/실패 콜백을 보낼 때도 동일 헤더로 사용한다.
INTERNAL_API_KEY=your_internal_api_key_here

# 비동기 분석 작업(ai_analysis_jobs) 관리 정책 (선택, 미설정 시 기본값 사용)
# JOB_TIMEOUT_MINUTES: PROCESSING 상태가 이 시간을 넘기면 좀비 작업으로 보고 FAILED 처리한다.
# JOB_RETENTION_DAYS: 종료(COMPLETED/FAILED)된 작업 행의 보존 기간. 0이면 자동 삭제하지 않는다.
JOB_TIMEOUT_MINUTES=30
JOB_RETENTION_DAYS=0

# Google API Config
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id_here