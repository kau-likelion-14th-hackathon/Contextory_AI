# ==========================================
# Environment & Secrets (환경변수 및 보안 데이터)
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Python Cache & Bytecode (파이썬 임시 파일)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# Virtual Environments & Conda (가상환경)
# ==========================================
.venv/
venv/
ENV/
env/
.conda/

# ==========================================
# IDE & Editor Settings (개발 툴 설정)
# ==========================================
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ==========================================
# Testing & Coverage (테스트 및 커버리지 결과물)
# ==========================================
.pytest_cache/
.coverage
htmlcov/
*.cover

# ==========================================
# OS Generated Files (운영체제 자동 생성 파일)
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# Logs & Databases (로그 및 로컬 임시 DB)
# ==========================================
*.log
*.sqlite
*.db

# ==========================================
# Local evaluation / test-run code & outputs (커밋 대상 아님)
# ==========================================
# 이 저장소는 루트 자체가 AI 파트이므로 AI_service/ 접두사 없이 등록합니다.
eval_local/
evaluation/results/
*.result.jsonl

# ==========================================
# Large local datasets & pipeline outputs (커밋 대상 아님)
# ==========================================
# Hugging Face Hub 에서 내려받은 원본(수백 MB~GB). 재현은 --dataset-id 로 합니다.
data/*
# 축소 데이터셋과 인덱싱/평가 산출물.

results/
logs/

